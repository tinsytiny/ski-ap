# Copy to .env (never commit real values). EXPO_PUBLIC_* values are visible inside the app.
EXPO_PUBLIC_APP_NAME=[APP NAME]
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_COOKIES_URL=
EXPO_PUBLIC_GUIDELINES_URL=
EXPO_PUBLIC_REFUND_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_CURRENT_PHASE=1
# DEV ONLY, never for a release build: bypasses the 5 km location check
# EXPO_PUBLIC_SKIP_LOCATION_CHECK=1

# Server only (your backend, never in the app)
DATABASE_URL=
AUTH_PROVIDER_SECRET=
PUSH_ACCESS_TOKEN=
CONDITIONS_CRON_SECRET=
# Only after written permission from each resort
REMARKABLES_API_KEY=
CORONET_PEAK_API_KEY=
CARDRONA_API_KEY=
ANALYTICS_KEY=
